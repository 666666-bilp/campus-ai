# ============================================
# 大学生学术AI助手 - 环境变量配置
# ============================================

# ---- 服务器配置 ----
NODE_ENV=production
PORT=3000

# ---- MongoDB Atlas ----
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/academic-ai?retryWrites=true&w=majority

# ---- JWT 密钥（务必修改为随机字符串）----
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=30d

# ---- Cloudinary 云存储 ----
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ---- AI 大模型 API ----
# 通用结构，支持切换不同模型提供商
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_API_KEY=sk-your-api-key
AI_MODEL=gpt-4o
AI_MAX_TOKENS=4096

# ---- 备用 AI 提供商 ----
AI_FALLBACK_URL=https://api.anthropic.com/v1/messages
AI_FALLBACK_KEY=sk-ant-your-key
AI_FALLBACK_MODEL=claude-sonnet-4-6

# ---- 速率限制 ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ---- 前端地址（CORS）----
CLIENT_URL=https://your-app.vercel.app

# ---- 文件上传限制 ----
MAX_FILE_SIZE=52428800
